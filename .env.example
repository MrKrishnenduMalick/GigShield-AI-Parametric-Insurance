# Razorpay credentials (get from https://razorpay.com/dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OpenAI API key — powers /api/explain-claim endpoint
# Get from https://platform.openai.com/api-keys
# If not set, endpoint falls back to rule-based explanation (still works)
OPENAI_API_KEY=your_openai_api_key_optional

# Server settings
PORT=8001
ENVIRONMENT=development
